# OpenRouter API Key for Jac by llm() agents
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Base URL (Default)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Models configured for Memora
VISION_MODEL=nvidia/nemotron-3.5-super-vl:free
REASONING_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Jac Cloud Server Port
JAC_PORT=8000
