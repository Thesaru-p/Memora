# =====================================================================
# Memora Multi-Agent Ebbinghaus Architecture - Environment Configuration
# =====================================================================

# OpenRouter API Key for Jac Agents
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Base URL
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Specialized Model Tiering for Memora Agents (Tested & Active Free Models)
# Agent 1 (Lecture Analyzer): 1M Context, Vision-Language for slide & note OCR
VISION_MODEL=nvidia/nemotron-3.5-super-vl:free

# Agent 2 & 3 (Deep Pedagogical Reasoning & Quiz Generator): 120B MoE reasoning
REASONING_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Agent 4 (Semantic Evaluator): Fast reasoning model for grading student answers
EVALUATOR_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# Agent 5 (Cognitive Scheduler & Day-1 Coach): Ultra-fast 273ms latency, 216 t/s
FAST_MODEL=liquid/lfm-2.5-2.6b:free

# Jac Cloud Server & Encoding Configuration
JAC_PORT=8000
PYTHONIOENCODING=utf-8
PYTHONUTF8=1
